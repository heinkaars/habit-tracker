.DS_Store
*.pem

# local env files
# Deny every .env variant and allow back only the committed template. The old
# rules were `.env` + `.env*.local`, which left `.env.production` (and
# `.env.staging`, `.env.development`) committable — one filename away from a
# secret in git history, where deleting it doesn't help and only rotation does.
.env*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Claude Code local settings
.claude/settings.local.json
