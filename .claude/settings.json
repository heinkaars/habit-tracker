{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run web)",
      "Bash(npm run web *)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo-doctor *)",
      "Bash(npx --yes expo-doctor@latest)",
      "Bash(npx --yes expo-doctor@latest *)",
